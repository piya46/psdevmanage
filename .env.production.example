# Copy to .env.production; chmod 600 .env.production before filling values.
# This file is read locally by deploy:gcp. It is NEVER copied into the image.
PSTON_DEPLOY_ENVIRONMENT=production
PSTON_GCP_PROJECT=your-project-id
PSTON_GCP_REGION=asia-southeast1
PSTON_GCP_NAME=pston-prod

# Exact HTTPS origin, no trailing slash. DNS/TLS must route to pston-prod-gateway.
WEB_ORIGIN=https://sign.example.com
# Authorized redirect URI in Google OAuth console:
# https://sign.example.com/api/auth/google/callback
GOOGLE_CLIENT_ID=replace-with-web-client-id.apps.googleusercontent.com
# Sent through stdin to Secret Manager, then pinned to a numeric secret version.
# Quote values containing # or spaces. Do not paste secrets into chat or CLI flags.
GOOGLE_CLIENT_SECRET="replace-locally"
# Initial allowed Google account. Add more exact Gmail/Workspace emails with commas.
# Matching ignores letter case; no wildcard/domain-wide access or automatic sign-up.
GOOGLE_ALLOWED_EMAILS=yourname@gmail.com

# Do not add P12 paths/passwords, private keys or runtime database variables here.
# Enable browser P12/PFX import into the deployment's dedicated Google Cloud HSM key ring.
# HSM key versions and operations incur additional Google Cloud charges.
PSTON_SIGNING_PROVIDER=google-cloud-hsm
