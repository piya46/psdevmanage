# Copy to .env; local demo is explicitly limited to test certificates.
PSTON_MODE=demo
WEB_ORIGIN=http://localhost:5173
HOST=127.0.0.1
GATEWAY_PORT=3000
IDENTITY_URL=http://127.0.0.1:3001
DOCUMENTS_URL=http://127.0.0.1:3002
SIGNING_URL=http://127.0.0.1:3003
AUDIT_URL=http://127.0.0.1:3004
PSTON_DATA_DIR=.local
# Required for Google login mode. No public sign-up or first-user claim.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exact Gmail/Google Workspace email addresses, comma-separated.
GOOGLE_ALLOWED_EMAILS=
# Example: http://localhost:5173/api/auth/google/callback
GOOGLE_REDIRECT_URI=
# Cloud deployment: npm run deploy:gcp -- --project YOUR_PROJECT_ID
# Production: use .env.production.example and --environment production --env-file .env.production
# The script manages cloud env/secrets; this file is not uploaded.
# Optional PostgreSQL adapter for a separately configured local test database:
# PSTON_STORE=postgres
# PGHOST=127.0.0.1
# PGDATABASE=pston_documents
# PGUSER=pston_documents
# PGPASSWORD=
# Runtime receives PSTON_BLOB_BUCKET and secret-file paths from the deploy script.
# TDID production signing is not implemented.
