{
  "name": "pston-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/dev.mjs --compiled --api-only",
    "deploy:gcp": "node scripts/deploy-gcp.mjs",
    "cert:check": "node scripts/check-p12.mjs",
    "build": "node --import tsx scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.6",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.7",
    "@fontsource/noto-sans-thai": "5.3.0",
    "@google-cloud/storage": "^8.4.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@signpdf/placeholder-pdf-lib": "4.0.0",
    "@signpdf/signpdf": "4.0.0",
    "@signpdf/utils": "4.0.0",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "fastify": "5.12.7",
    "google-auth-library": "^11.3.1",
    "jose": "6.2.13",
    "lucide-react": "1.61.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "pg": "^8.23.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
